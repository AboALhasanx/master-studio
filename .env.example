# Sieve scrape API key (server-side only)
# Never commit the real key: .env is gitignored via the .env* rule.
# Create a key at https://scrape.usesieve.com -> Settings -> API keys,
# or run the device login: python 90_Shared_Toolbox/tools/sieve_login.py
SIEVE_API_KEY=

# Telegram gateway bot (Bot API) — roadmap gate G0/G2, issues #8/#9
# Real token goes into local `.env` only (gitignored by the `.env*` rule).
TELEGRAM_BOT_TOKEN=
# Disposable test group id; production group promoted only at gate G5
TELEGRAM_TEST_CHAT_ID=
# Live-transport chat allowlist, comma separated, fail closed when empty (G2)
TELEGRAM_CHAT_ALLOWLIST=
# Fail-closed allowlist of Telegram user ids that may drive the gateway (#16)
TELEGRAM_OWNER_IDS=

# Interactive layer (ADR D15) — mention-driven replies, on demand.
# The bot's @username (without the @), used to detect mentions in a session.
TELEGRAM_BOT_USERNAME=
