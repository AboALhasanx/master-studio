90_Shared_Toolbox/telegram/registry.json
90_Shared_Toolbox/telegram/__pycache__/

# Interactive layer runtime state (ADR D15/D16): pending admin approvals are
# live state, not source — a fresh clone starts with an empty ledger.
00_STUDIO_HUB/telegram/pending_approval.json

# MTProto user-account sessions (issue #22): a Telethon *.session stores the
# auth_key, i.e. full control of the account with no password and no 2FA.
# This repo is public — committing one would hand the account over.
*.session
*.session-journal
# single-use login hand-off: the phone number plus a hash that is dead in
# about two minutes, so it must never outlive the login attempt either
00_STUDIO_HUB/telegram/login_state.json
# live pacing ledger — real send stamps, not source; a fresh clone starts
# with an empty budget like any other runtime state
00_STUDIO_HUB/telegram/pacing.json

